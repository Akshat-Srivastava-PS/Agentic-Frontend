{
  "name": "agent-first-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild server/src/serve.ts --bundle --platform=node --format=esm --target=node22 --external:better-sqlite3 --outfile=server/src/serve.js",
    "start": "node server/src/serve.js"
  },
  "dependencies": {
    "@hatch/space-sdk": "file:./packages/space-sdk",
    "@tanstack/react-query": "^5.66.0",
    "better-sqlite3": "^11.8.1",
    "drizzle-orm": "^0.39.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.0.0",
    "tailwindcss-safe-area": "^1.3.0",
    "typescript": "^5.6.3",
    "vite": "^6.1.0"
  }
}
